<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record model="ir.ui.view" id="l10n_br_fiscal_dfe_document_form">
        <field name="name">l10n_br_fiscal_dfe.document.form</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="DF-e Access Key">
                <header>
                    <button string="XML" name="action_download_xml" type="object" />
                    <button string="DANFE" name="make_pdf" type="object" />
                    <button name="import_document" string="Import" type="object" />
                    <button
                        string="Manifest"
                        name="create_nfe_md_action"
                        type="object"
                    />
                </header>
                <separator string="Access Key" />
                <field name="access_key" select="1" required="1" readonly="1" />
                <separator string="Document Info" />
                <group>
                    <field
                        name="manifestation_status"
                        widget="badge"
                        decoration-success="manifestation_status == 'Confirmação de Operação pelo Destinatário'"
                        decoration-info="manifestation_status == 'Ciência da Operação pelo Destinatário'"
                        decoration-warning="manifestation_status == 'Desconhecimento da Operação pelo Destinatário'"
                        decoration-danger="manifestation_status == 'Operação não Realizada'"
                        decoration-muted="manifestation_status == 'Evento Desconhecido'"
                        readonly="1"
                    />
                    <field name="manifestations_ids" readonly="1" />
                    <field name="document_state" />
                    <field name="document_number" />
                    <field name="emitter" readonly="1" />
                    <field name="vat" readonly="1" />
                    <field name="document_amount" widget="monetary" readonly="1" />
                </group>
                <field name="dfe_ids">
                    <tree>
                        <field name="dfe_nfe_document_type" string="DF-e" />
                        <field name="nsu" />
                        <button
                            string="XML"
                            name="action_download_xml"
                            type="object"
                            icon="fa-download"
                        />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="l10n_br_fiscal_dfe_document_tree">
        <field name="name">l10n_br_fiscal_dfe.document.tree</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                decoration-success="color_status == 'green'"
                decoration-info="color_status == 'blue'"
                decoration-muted="color_status == 'normal'"
            >
                <field name="color_status" invisible="1" />
                <field name="document_number" string="Number" />
                <field name="document_emission_date" string="Date" widget="date" />
                <field name="access_key" />
                <field name="emitter" />
                <field name="vat" />
                <field name="document_amount" string="Amount" />
                <field
                    name="manifestation_status"
                    widget="badge"
                    string="Manifestation"
                    decoration-success="manifestation_status == 'Confirmação de Operação pelo Destinatário'"
                    decoration-info="manifestation_status == 'Ciência da Operação pelo Destinatário'"
                    decoration-warning="manifestation_status == 'Desconhecimento da Operação pelo Destinatário'"
                    decoration-danger="manifestation_status == 'Operação não Realizada'"
                    decoration-muted="manifestation_status == 'Evento Desconhecido'"
                />
                <button
                    string="XML"
                    name="action_download_xml"
                    type="object"
                    icon="fa-file-code-o"
                />
                <button
                    string="DANFE"
                    name="make_pdf"
                    type="object"
                    icon="fa-file-pdf-o"
                />
                <button
                    name="import_document"
                    string="Import"
                    type="object"
                    icon="fa-file-text-o"
                />
                <button
                    string="Manifestar"
                    name="create_nfe_md_action"
                    type="object"
                    icon="fa-check-square-o"
                />
            </tree>
        </field>
    </record>

    # TODO remover?
    <record model="ir.actions.act_window" id="dfe_document_action">
        <field name="name">DF-e Access Key</field>
        <field name="res_model">l10n_br_fiscal_dfe.document</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
