<odoo>

    <record model="ir.ui.view" id="l10n_br_fiscal_dfe_document_form">
        <field name="name">l10n_br_fiscal_dfe.document.form</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="DF-e Document" create="false">
                <header>
                    <button string="XML" name="action_download_xml" type="object" />
                    <button string="DANFE" name="make_pdf" type="object" />
                    <button name="import_document" string="Import" type="object" />
                    <button
                        string="Manifest"
                        name="create_nfe_md_action"
                        type="object"
                    />
                </header>
                <separator string="Access Key" />
                <field name="access_key" select="1" required="1" readonly="1" />
                <separator string="Document Info" />
                <group>
                    <field
                        name="manifestation_status"
                        widget="badge"
                        decoration-success="manifestation_status == 'confirmado'"
                        decoration-info="manifestation_status == 'ciente'"
                        decoration-warning="manifestation_status == 'desconhecido'"
                        decoration-danger="manifestation_status == 'nao_realizado'"
                        decoration-muted="manifestation_status == 'sem_manifestacao'"
                        readonly="1"
                    />
                    <field name="manifestations_ids" readonly="1" />
                    <field name="document_state" />
                    <field name="document_number" />
                    <field name="emitter" readonly="1" />
                    <field name="vat" readonly="1" />
                    <field name="document_amount" widget="monetary" readonly="1" />
                    <field name="cfop_ids" widget="many2many_tags" readonly="1" />
                </group>
                <field name="dfe_ids">
                    <tree>
                        <field name="dfe_nfe_document_type" string="DF-e" />
                        <field name="nsu" />
                        <button
                            string="XML"
                            name="action_download_xml"
                            type="object"
                            icon="fa-download"
                        />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="l10n_br_fiscal_dfe_document_tree">
        <field name="name">l10n_br_fiscal_dfe.document.tree</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                banner_route="/l10n_br_fiscal_dfe/document_banner"
                decoration-success="color_status == 'green'"
                decoration-info="color_status == 'blue'"
                decoration-muted="color_status == 'normal'"
            >
                <field
                    name="color_status"
                    widget="badge"
                    string="Type"
                    decoration-success="color_status == 'green'"
                    decoration-info="color_status == 'blue'"
                    decoration-muted="color_status == 'normal'"
                />
                <field name="document_emission_date" string="Date" widget="date" />
                <field name="access_key" />
                <field name="emitter" />
                <field name="vat" />
                <field name="document_amount" string="Amount" />
                <field name="cfop_ids" widget="many2many_tags" string="CFOPs" />
                <field
                    name="manifestation_status"
                    widget="badge"
                    string="Manifestation"
                    decoration-success="manifestation_status == 'confirmado'"
                    decoration-info="manifestation_status == 'ciente'"
                    decoration-warning="manifestation_status == 'desconhecido'"
                    decoration-danger="manifestation_status == 'nao_realizado'"
                    decoration-muted="manifestation_status == 'sem_manifestacao'"
                />
                <field name="document_state" string="State" />
                <button
                    string="XML"
                    name="action_download_xml"
                    type="object"
                    icon="fa-file-code-o"
                />
                <button
                    string="DANFE"
                    name="make_pdf"
                    type="object"
                    icon="fa-file-pdf-o"
                />
                <button
                    name="import_document"
                    string="Import"
                    type="object"
                    icon="fa-file-text-o"
                />
                <button
                    string="Manifest"
                    name="create_nfe_md_action"
                    type="object"
                    icon="fa-check-square-o"
                />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="l10n_br_fiscal_dfe_document_search">
        <field name="name">l10n_br_fiscal_dfe.document.search</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <search string="DF-e Documents">
                <field name="access_key" />
                <field name="emitter" />
                <field name="vat" />
                <field name="company_id" />
                <separator />
                <filter
                    name="third_party"
                    string="Third-party"
                    domain="[('is_own_document', '=', False)]"
                />
                <filter
                    name="own_documents"
                    string="Own Documents"
                    domain="[('is_own_document', '=', True)]"
                />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="dfe_document_action">
        <field name="name">Documents</field>
        <field name="res_model">l10n_br_fiscal_dfe.document</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_third_party': 1}</field>
    </record>

</odoo>
