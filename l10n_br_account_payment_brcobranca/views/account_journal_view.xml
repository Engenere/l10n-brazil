<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="journal_importer_view_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_move_base_import.journal_importer_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='split_counterpart']]" position="after">
                <group
                    name="group_brcobranca_cnab_return"
                    string="CNAB Return"
                    attrs="{'invisible': [('import_type', 'not in', ['cnab400','cnab240'])]}"
                >
                    <field name="return_auto_reconcile" />
                    <field name="cnab_return_skip_fee_entry" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
